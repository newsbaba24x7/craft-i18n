msgstr "{words} சொற்கள்"

msgid "{words} words and counting. Literally. I'm counting."
msgstr "{words} சொற்கள், எண்ணிக்கை தொடர்கிறது. உண்மையாகவே. நான்தான் எண்ணிக்கொண்டிருக்கிறேன்."

msgid "{words} words! I'd throw confetti but I'd have to clean it up."
msgstr "{words} சொற்கள்! வண்ணக் காகிதத் துண்டுகளைத் தூவியிருப்பேன், ஆனால் பிறகு நானே சுத்தம் செய்ய வேண்டியிருக்கும்."

msgid "{words} words. That's {words} more than I've written today."
msgstr "{words} சொற்கள். இன்று நான் எழுதியதைவிட {words} அதிகம்."

msgid "“{text}” ({row}, {series}) isn't a number."
msgstr "“{text}” ({row}, {series}) ஓர் எண் அல்ல."

msgid "✓ None"
msgstr "✓ எதுவுமில்லை"

msgid "➕ New comment"
msgstr "➕ புதிய கருத்து"

msgid "📂  Browse…"
msgstr "📂  உலாவு…"
